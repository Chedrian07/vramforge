# VRAMForge docker compose 설정 예시
#
# .env 파일은 필요 없습니다. 아래 값은 모두 compose.yaml의 기본값과 같습니다. 바꾸고 싶은 줄만
# .env에 옮겨 적어 수정하세요. 파일 전체를 복사하면(cp .env.example .env) 이미지 버전 같은 기본값까지
# .env에 고정되어, 업그레이드로 compose.yaml의 기본값이 바뀌어도 이전 값이 계속 쓰입니다.
# 주석 처리된 항목(#)은 선택 항목입니다. 설정하지 않으면 컨테이너에 전달되지 않고 API 기본값을 씁니다.
# .env에는 비밀값이 들어갈 수 있으므로 커밋하지 않습니다(.gitignore 대상). 설명: docs/deployment.md

# --- 접속 주소 -----------------------------------------------------------------------------
# 프록시가 호스트에 publish하는 주소와 포트. 기본은 이 컴퓨터에서만 접속 가능(localhost).
# 0.0.0.0으로 외부에 열 때는 HTTPS 종단과 VRAMFORGE_ACCESS_TOKEN이 필요합니다(docs/deployment.md).
VRAMFORGE_BIND=127.0.0.1
VRAMFORGE_PORT=8080

# 접근 토큰. 설정하면 모든 API 요청에 이 토큰이 필요합니다. 외부 공개 시 필수.
# VRAMFORGE_ACCESS_TOKEN=

# HTTPS 종단(reverse proxy, 터널 등) 뒤에서 서비스할 때 true로 바꿉니다. owner cookie에 Secure를 붙입니다.
VRAMFORGE_COOKIE_SECURE=false

# --- Hugging Face ---------------------------------------------------------------------------
# gated/private 저장소를 분석할 때만 필요합니다. 읽기 전용(read) 최소 권한 토큰을 쓰세요.
# 셸에 HF_TOKEN이 export되어 있으면 그 값도 컨테이너로 전달됩니다.
# HF_TOKEN=
# 서버 토큰을 이 인스턴스의 모든 분석에 쓸지 정합니다. 기본 false: 토큰을 설정해도 쓰지 않으며
# 비공개·gated 저장소는 접근 거부로 끝납니다(서비스 계정이 사용자 권한을 대신하지 않음).
# 혼자 쓰는 배포에서만 true로 바꾸세요. 설명: docs/deployment.md §5
VRAMFORGE_SHARE_SERVER_HF_TOKEN=false

# --- 로컬 모델·데이터셋 ----------------------------------------------------------------------
# 호스트 폴더 → 컨테이너 /sources/local (읽기 전용). 참조 형식: local:local/<상대 경로>
VRAMFORGE_LOCAL_SOURCES_DIR=./local-sources
# API·worker가 허용하는 root 목록(name=/컨테이너/절대경로, 쉼표 구분). 폴더를 추가로 mount할 때만 바꿉니다.
VRAMFORGE_LOCAL_ROOTS=local=/sources/local

# --- 업로드·작업 한도 ------------------------------------------------------------------------
# 프록시의 요청 본문 상한. 업로드 상한(VRAMFORGE_MAX_UPLOAD_BYTES)을 올리면 이 값도 함께 올립니다.
VRAMFORGE_PROXY_MAX_BODY_SIZE=2049MiB
# 아래는 API 설정입니다. 표시된 값은 API 기본값이며, 설정하지 않으면 그 기본값을 씁니다.
# VRAMFORGE_MAX_UPLOAD_BYTES=2147483648
# 사용자 한 명이 보관할 수 있는 업로드 합계(만료 전 파일 기준, 기본 10 GiB).
# VRAMFORGE_MAX_UPLOAD_BYTES_PER_OWNER=10737418240
# VRAMFORGE_MAX_CONCURRENT_JOBS_PER_OWNER=2
# VRAMFORGE_JOB_TIMEOUT_S=21600
# VRAMFORGE_RETENTION_DAYS=7
# VRAMFORGE_LOG_LEVEL=INFO

# --- PostgreSQL ---------------------------------------------------------------------------
# 내부 네트워크 전용이며 호스트에 publish하지 않습니다. 비밀번호는 처음 볼륨을 만들 때만 적용됩니다.
# URL에 들어가므로 영문·숫자 위주로 지정하세요(@ : / % 등은 피함).
POSTGRES_USER=vramforge
POSTGRES_PASSWORD=vramforge
POSTGRES_DB=vramforge

# --- 이미지 (Docker Hub pull 한도에 걸리면 mirror로 교체) -------------------------------------
# 예: PYTHON_IMAGE=mirror.gcr.io/library/python:3.12.15-slim-trixie
PYTHON_IMAGE=python:3.12.15-slim-trixie
UV_IMAGE=ghcr.io/astral-sh/uv:0.12.23
NODE_IMAGE=node:24.21.0-trixie-slim
CADDY_IMAGE=caddy:2.11.6-alpine
POSTGRES_IMAGE=postgres:18.6-alpine
REDIS_IMAGE=redis:8.10.2-alpine
