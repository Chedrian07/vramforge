# VRAMForge reverse proxy: the single same-origin entry point (docs/architecture.md §1).
#   /api/*    -> api:8000  (FastAPI; SSE progress streams)
#   /healthz  -> local liveness answer for the container healthcheck
#   else      -> web:3000  (Next.js standalone)
# TLS is not terminated here; see docs/deployment.md before exposing beyond localhost.
# Behaviour verified for Caddy 2.11.6 in docs/research/stack-compat.md §8 and §10.8 (E11-E14).
{
	admin off
	auto_https off
	persist_config off
}

:80 {
	handle /healthz {
		respond "ok" 200
	}

	handle /api/* {
		# Upper bound for request bodies (dataset uploads). The API enforces its own, smaller
		# limit and answers with a structured error; this only stops oversized streams early.
		request_body {
			max_size {$VRAMFORGE_PROXY_MAX_BODY_SIZE:10GB}
		}
		# No flush_interval is needed: Caddy flushes text/event-stream responses immediately
		# (reverseproxy/streaming.go Handler.flushInterval, stack-compat.md §8 V22). Upstream
		# read/write timeouts stay unlimited so long SSE streams and uploads are never cut.
		reverse_proxy api:8000 {
			lb_try_duration 5s
			transport http {
				dial_timeout 5s
				response_header_timeout 10m
			}
		}
	}

	handle {
		reverse_proxy web:3000 {
			lb_try_duration 5s
			transport http {
				dial_timeout 5s
			}
		}
	}

	# Compress text responses, but never text/event-stream: the list below replaces Caddy's
	# default "text/*" match so SSE always passes through unencoded and unbuffered.
	encode {
		zstd
		gzip
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
			header Content-Type text/javascript*
			header Content-Type text/x-component*
			header Content-Type text/markdown*
			header Content-Type text/csv*
			header Content-Type text/yaml*
			header Content-Type text/xml*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type application/problem+json*
			header Content-Type application/manifest+json*
			header Content-Type application/xml*
			header Content-Type application/yaml*
			header Content-Type application/x-yaml*
			header Content-Type image/svg+xml*
			header Content-Type image/x-icon*
			header Content-Type image/vnd.microsoft.icon*
		}
	}

	# Safe defaults that do not restrict Next.js scripts or styles. The CSP only covers framing,
	# <base>, form targets and plugins; script/style sources are left to the app.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
}
